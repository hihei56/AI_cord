# --- 1つ目のアカウント(無印の変数名。省略時のデフォルト) ---
DISCORD_TOKEN=ここにあなたのDiscordトークン
ALLOWED_GUILD_ID=ここにサーバーID
ALLOWED_CHANNEL_ID=ここにチャンネルID
# config/personas/ 内のファイル名（拡張子なし）を指定。省略時は default。
# 空文字("")か "none" にすると人格プロンプト無し(マルコフ下書き+最低限の誤字脱字修正のみ)で動く
PERSONA=default
# config/corpus/ 内のファイル名。省略時は config/settings.json の markov.corpusFile
CORPUS_FILE=default.txt
# config/presence/ 内のファイル名(Spotify/視聴中ステータスのRPC偽装)。省略時は config/settings.json の presenceFile
PRESENCE_FILE=default.json

# テスト用チャンネル(任意)。設定すると、このチャンネルでは応答チャンネル登録の有無・
# クールダウン・返信確率・crowdGuardを全部無視して常に即応答する(動作確認用)。
# 2つ目以降のアカウントは TEST_CHANNEL_ID_2 のように番号を付ければ個別に設定できる
# TEST_CHANNEL_ID=

# 応答してよい相手を制限したい場合(任意、カンマ区切りで複数可)。設定すると、
# ここに書いたユーザーID以外の発言には自動応答しなくなる。未設定なら今まで通り誰にでも反応する。
# 2つ目以降のアカウントは ALLOWED_REPLY_USER_IDS_2 のように番号を付ければ個別に設定できる
# ALLOWED_REPLY_USER_IDS=ここにユーザーID,ここに2つ目のユーザーID

# --- 2つ目以降のアカウント(任意。番号付きの変数名で追加) ---
# 同じ書き方で _2, _3, _4, _5, _6... と増やしていけば、1プロセスで何体でも
# 複数アカウントを同時に動かせる(アカウントごとに応答チャンネル・ロックダウン状態・
# マルコフ連鎖・RPCは独立して管理される)。上限は無く、DISCORD_TOKEN_N が
# 設定されている番号まで自動的に読み込まれる。
# DISCORD_TOKEN_2=
# ALLOWED_GUILD_ID_2=
# ALLOWED_CHANNEL_ID_2=
# PERSONA_2=
# CORPUS_FILE_2=
# PRESENCE_FILE_2=

# --- 3〜6体目(合計6アカウントまでの例。さらに増やす場合は同じ書き方で_7,_8...) ---
# DISCORD_TOKEN_3=
# ALLOWED_GUILD_ID_3=
# ALLOWED_CHANNEL_ID_3=
# PERSONA_3=
# CORPUS_FILE_3=
# PRESENCE_FILE_3=

# DISCORD_TOKEN_4=
# ALLOWED_GUILD_ID_4=
# ALLOWED_CHANNEL_ID_4=
# PERSONA_4=
# CORPUS_FILE_4=
# PRESENCE_FILE_4=

# DISCORD_TOKEN_5=
# ALLOWED_GUILD_ID_5=
# ALLOWED_CHANNEL_ID_5=
# PERSONA_5=
# CORPUS_FILE_5=
# PRESENCE_FILE_5=

# DISCORD_TOKEN_6=
# ALLOWED_GUILD_ID_6=
# ALLOWED_CHANNEL_ID_6=
# PERSONA_6=
# CORPUS_FILE_6=
# PRESENCE_FILE_6=

# 所有者本人以外にも、このロールID(カンマ区切りで複数可)を持つサーバーメンバーなら
# コマンドを実行できるようにする(任意)。未設定時は src/utils/config.js の
# DEFAULT_COMMAND_ROLE_IDS がそのまま使われる。別のロールに変えたい時だけ指定する
# ALLOWED_COMMAND_ROLE_ID=ここにロールID,ここに2つ目のロールID
# ALLOWED_COMMAND_ROLE_ID_2=

# コマンドのprefix(任意)。未設定時は src/utils/config.js の DEFAULT_COMMAND_PREFIXES
# (1つ目 toku! / 2つ目 sui!)が使われる。どのアカウント宛てか紛らわしくならないようアカウントごとに分けている
# COMMAND_PREFIX=toku!
# COMMAND_PREFIX_2=sui!

# 使うAI(OpenAI互換のChat Completions API)の接続先。全アカウント共通。
#
# GROQ_API_KEY / GEMINI_API_KEY / CEREBRAS_API_KEY / NVIDIA_API_KEY を複数
# 入れておけば、起動後は.envを書き換えずDiscord上の
# !provider groq|gemini|cerebras|nvidia コマンドだけで実行中に切り替えられる
# (詳しくはREADMEの「AIバックエンドの切り替え」参照)。AI_PROVIDERはあくまで
# 起動時点の初期値(省略時 groq)。モデル名もプロバイダの既定値
# (groq: openai/gpt-oss-120b, gemini: gemini-3.6-flash, cerebras: gpt-oss-120b,
# nvidia: meta/llama-3.3-70b-instruct)に自動で切り替わるが、AI_MODELで
# 明示指定すれば常にそちらが優先される
AI_PROVIDER=groq
GROQ_API_KEY=ここにGroqのAPIキー
# GEMINI_API_KEY=ここにGeminiのAPIキー(https://aistudio.google.com/apikey で発行)
# CerebrasはGroqと同じgpt-oss-120bを配信していて1日の消費上限が緩い。無料枠の
# カード登録要否は情報源により食い違うので、実際に設定して動くか試すこと
# CEREBRAS_API_KEY=ここにCerebrasのAPIキー(https://cloud.cerebras.ai で発行)
# NVIDIA NIM(build.nvidia.com)は無料枠40RPM、登録時に約1000クレジット付与
# (カード不要)。ただし公式に評価用途向けと明記されており、モデルの命名規則
# (vendor/model形式)もカタログ変更が多いので、動かない場合はAI_MODELで
# build.nvidia.comに掲載の正確なモデルIDを指定すること
# NVIDIA_API_KEY=ここにNVIDIAのAPIキー(https://build.nvidia.com で発行)
# AI_MODEL=

# AI_BASE_URL/AI_API_KEYを明示指定すると、AI_PROVIDERより優先される
# (自前ホストのAPI(vLLM/Ollama等)や、上記以外のOpenAI互換サービスを使う場合用)
# AI_BASE_URL=
# AI_API_KEY=

# 画像添付メッセージの解析用API(任意)。未設定ならAI_PROVIDER(=会話用と同じ接続先)を使い回す。
# 会話用と別のプロバイダにしたい場合だけ VISION_AI_PROVIDER を指定する
# VISION_AI_PROVIDER=
# VISION_MODEL=
# VISION_API_BASE_URL=
# VISION_API_KEY=

# アカウントごとのファインチューニング済みモデル接続先(任意)。設定した上で
# !set mode @account finetune で切り替えると、そのアカウントはペルソナ文書・
# マルコフ下書きを使わずこのAPIに直接投げるようになる(!set mode @account markov で戻せる)
# FINETUNE_BASE_URL_3=http://localhost:11434/v1
# FINETUNE_API_KEY_3=
# FINETUNE_MODEL_3=ここにモデル名
# 起動時点でfinetuneモードにしたい場合(未設定ならmarkov。!set modeで実行中に切り替えても
# 再起動でmarkovに戻るので、常時finetuneで使いたいならここで指定する)
# AI_MODE_3=finetune
