# --- 1つ目のアカウント(無印の変数名。省略時のデフォルト) ---
DISCORD_TOKEN=ここにあなたのDiscordトークン
ALLOWED_GUILD_ID=ここにサーバーID
ALLOWED_CHANNEL_ID=ここにチャンネルID
# config/personas/ 内のファイル名（拡張子なし）を指定。省略時は default
PERSONA=default
# config/corpus/ 内のファイル名。省略時は config/settings.json の markov.corpusFile
CORPUS_FILE=default.txt

# --- 2つ目以降のアカウント(任意。番号付きの変数名で追加) ---
# 同じ書き方で _2, _3... と増やしていけば、1プロセスで複数アカウントを
# 同時に動かせる(アカウントごとに応答チャンネル・ロックダウン状態・
# マルコフ連鎖は独立して管理される)。
# DISCORD_TOKEN_2=
# ALLOWED_GUILD_ID_2=
# ALLOWED_CHANNEL_ID_2=
# PERSONA_2=
# CORPUS_FILE_2=

# 使うAI(OpenAI互換のChat Completions API)の接続先。全アカウント共通。
# Groqならデフォルトのままでよい。自前ホストのAPI(vLLM/Ollama等)を使う場合はここを差し替える
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=ここにAPIキー
# 互換性のため GROQ_API_KEY でも動作するが、AI_API_KEY を優先的に使う
